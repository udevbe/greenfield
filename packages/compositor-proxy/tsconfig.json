{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDirs": ["src"],
    "pretty": true,
    "declarationDir": "types",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "removeComments": true
  },
  "exclude": [".eslintrc.js", ".prettierrc.js"]
}
