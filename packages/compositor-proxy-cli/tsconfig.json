{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDirs": ["src"],
    "pretty": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "removeComments": true
  },
  "exclude": [".eslintrc.js", ".prettierrc.js"]
}
